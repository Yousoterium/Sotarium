# Replacement Supabase project. Set these in Vercel Production and Preview environments.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Earnpaste is called from /api/earnpaste so its API key is never exposed to the browser.
EARNPASTE_API_KEY=YOUR_EARNPASTE_SERVER_ONLY_API_KEY

# Work.ink's base publisher link stays server-side. /api/workink obtains a
# per-user Link Override URL so the fixed base link is never returned directly.
WORKINK_BASE_LINK=https://work.ink/YOUR_PUBLISHER_ID/YOUR_LINK_SLUG

# Public provider configuration used by the website UI.
VITE_LOCKR_ID=YOUR_LOCKER_ID
